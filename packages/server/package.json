{
  "name": "@ahpd/server",
  "version": "0.15.0",
  "type": "module",
  "os": ["linux", "darwin"],
  "description": "The ahpd daemon: a self-hosted, extensible agent host built on the Agent Host Protocol. Run Claude, Pi, Codex, Gemini, and other ACP-compatible agents, with scheduling, team management, usage tracking and a model gateway built in, and webhooks, isolated computers and more as plugins.",
  "keywords": [
    "ahp",
    "agent-host-protocol",
    "agent-host",
    "agent",
    "ai",
    "protocol",
    "json-rpc",
    "websocket",
    "cli",
    "command-line",
    "daemon",
    "plugin"
  ],
  "author": "Luiz Fernando Softov <lfs@softov.dev>",
  "license": "MIT",
  "homepage": "https://github.com/ahpio/ahpd/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahpio/ahpd.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/ahpio/ahpd/issues"
  },
  "bin": {
    "ahpd": "./dist/main.js"
  },
  "files": [
    "dist",
    "icons",
    "shellintegration",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=24"
  },
  "scripts": {
    "prepack": "tsc -p .",
    "test": "cd ../.. && vitest run packages/server/test"
  },
  "dependencies": {
    "@ahpd/deploy": "workspace:*",
    "@ahpd/sdk": "workspace:*",
    "@bearly/durable-file": "github:beorn/bearly#00a4322732bcb079ee76200493d9f8fca9868024&path:/packages/durable-file",
    "@cofold/commands": "^0.3.0",
    "@cofold/config": "^0.3.1",
    "@cofold/remote": "^0.5.0",
    "@cofold/terminal": "^0.5.1",
    "@cofold/yaml": "^0.3.0",
    "@microsoft/agent-host-protocol": "^1.1.0",
    "@xterm/headless": "^6.0.0",
    "semver": "^7.8.5"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0-beta40"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  }
}
