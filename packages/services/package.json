{
  "name": "@ahpd/services",
  "version": "0.15.0-rc.4",
  "type": "module",
  "os": ["linux", "darwin"],
  "description": "A machine's services for ahpd: the process-compose driver, and the machine-local switches only the machine can set.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
