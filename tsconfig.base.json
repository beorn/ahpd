{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023",
      "es2024.promise"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "node"
    ]
  }
}
