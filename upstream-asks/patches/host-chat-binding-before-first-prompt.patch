From 99935dd5b4bc6c2342e52b09f29ea9943c6ee41b Mon Sep 17 00:00:00 2001
From: "@dev/5" <dev-5@main.hh.invalid>
Date: Wed, 18 Nov 2026 16:44:34 -0800
Subject: [PATCH] fix(host): keep a created session's harness and folder before
 its first chat binding is saved

A changed chat binding is saved before its setter returns (2ab6dcb47), and
that save writes the whole record. On create, the fresh-conversation
binding was kept before the session's folder, so the first record file had
no workingDirectory; a host killed in that tick left a record that rc.4's
restore-on-open reopens with no folder. The folder alone cannot be kept
first: a row holding only a folder is empty and not kept, so the harness
is recorded with it. A failed start still forgets the whole row.

host-past-open "writes the folder of a session it creates into the record
file" fails at 11d02024 and passes here.

Refs: hh #34945, #33485
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 packages/sdk/src/host/spawn.ts | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/packages/sdk/src/host/spawn.ts b/packages/sdk/src/host/spawn.ts
index ef67d2c77..0b18c63a3 100644
--- a/packages/sdk/src/host/spawn.ts
+++ b/packages/sdk/src/host/spawn.ts
@@ -2030,7 +2030,20 @@ export function createSpawn(ctx: HostContext): Spawn {
      * failure being the failure of whatever asked for it.
      */
     // Only initial host creation establishes original ownership, before any backend handshake can run.
-    if (freshConversation === true) ctx.keepChat(uri, chatUri, chatId ?? idOf(uri), true, undefined, undefined, true);
+    if (freshConversation === true) {
+      /*
+       * Its harness and folder first. A changed chat binding is saved before
+       * its setter returns, and that save writes the whole record, so a folder
+       * kept after it would be missing from the record a host killed in this
+       * tick leaves behind, which a restore-on-open then reopens with no
+       * folder. The harness goes with it because a row that holds only a
+       * folder is an empty row, and an empty row is not kept. A start that
+       * fails forgets the whole row, as it does the title kept before it.
+       */
+      kept.setProvider(idOf(uri), agent.provider);
+      keepFolder(idOf(uri), workingDirectory);
+      ctx.keepChat(uri, chatUri, chatId ?? idOf(uri), true, undefined, undefined, true);
+    }
     const made = used.create(wired);
     const session = made instanceof Promise ? await made : made;
     titled = session;
-- 
2.56.0

