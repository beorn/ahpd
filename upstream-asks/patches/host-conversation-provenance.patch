diff --git a/packages/sdk/src/sessions/sessions.ts b/packages/sdk/src/sessions/sessions.ts
index a44071142..873ba8f2b 100644
--- a/packages/sdk/src/sessions/sessions.ts
+++ b/packages/sdk/src/sessions/sessions.ts
@@ -463,6 +463,7 @@ const chatsOf = (value: unknown): StoredChat[] | undefined => {
     return [{
       uri: held.uri,
       backendId: held.backendId,
+      ...(typeof held.sessionConversation === 'boolean' ? { sessionConversation: held.sessionConversation } : {}),
       ...(text(held.provider) ? { provider: held.provider } : {}),
       ...(typeof config === 'object' && config !== null && !Array.isArray(config)
         ? { config: config as Record<string, unknown> }
diff --git a/packages/sdk/src/types/sessions.ts b/packages/sdk/src/types/sessions.ts
index ff6379706..28106fb3e 100644
--- a/packages/sdk/src/types/sessions.ts
+++ b/packages/sdk/src/types/sessions.ts
@@ -131,6 +131,8 @@ export interface StoredChat {
    * has not said one, which is a chat nothing can be resumed from.
    */
   backendId: string;
+  /** Host-recorded original conversation: true for the original, false for a peer, absent for legacy unknown. */
+  sessionConversation?: boolean;
   /**
    * The backend that serves this chat, where it is not the session's own.
    *
diff --git a/packages/sdk/test/sessions.test.ts b/packages/sdk/test/sessions.test.ts
index 106195e90..09205b178 100644
--- a/packages/sdk/test/sessions.test.ts
+++ b/packages/sdk/test/sessions.test.ts
@@ -655,6 +655,23 @@ it('keeps the backend a chat runs on, and its config, so a restart starts it the
   expect(loaded[1]).toEqual({ uri: 'ahp-chat:/odd', backendId: 'odd' });
 });
 
+it('keeps original, peer and unknown conversation provenance across a synchronous file-store restart', () => {
+  // 32996: provenance must survive before create is accepted; backend/default fields cannot recover it.
+  // Existing store cases contain no true/false/absent provenance and miss a parser dropping that fact.
+  const dir = join(root, 'sessions');
+  const held = [
+    { uri: 'ahp-chat:/original', backendId: 'replaced-id', sessionConversation: true },
+    { uri: 'ahp-chat:/peer', backendId: 'peer', default: true, sessionConversation: false },
+    { uri: 'ahp-chat:/legacy', backendId: 'legacy' },
+  ];
+  fileSessions({ dir }).setChats('a', held);
+  const restarted = fileSessions({ dir });
+  expect(restarted.chats('a')).toEqual(held);
+  restarted.setChats('a', restarted.chats('a').map((chat) => ({ ...chat, closed: true })));
+  restarted.close?.();
+  expect(fileSessions({ dir }).chats('a')).toEqual(held.map((chat) => ({ ...chat, closed: true })));
+});
+
 it('forgets a session entirely, whatever was set on it', () => {
   const store = memorySessions();
   store.setFlags('a', ARCHIVED);
-- 
