From e1b7097f2d0209aac70cd3f1920fde2b85029523 Mon Sep 17 00:00:00 2001
From: "@dev/8" <dev-8@main.hh.invalid>
Date: Sat, 21 Nov 2026 11:27:39 -0800
Subject: [PATCH] fix(sleep): ask for the sleep on every archive offer (#37426)

sessionFlag latched on the bit not moving: a repeated archive offer returned
before the archived-sleep block, so an offer refused for the watchers of that
moment was never asked again. The steward's release is asynchronous, so the
stop's re-offer always lost.

The latch is about dispatch - a client is not woken for a message that moved
nothing, which is what a7343dc1 put it there for - and it stays for the flag,
the summary and the movability update. The sleep offer is about the watchers
right now, so it is made on every offer; the unarchive side keeps the latch.

@cto 2026-11-21 (tribe 341b4ef0): (b), no new control message and no per-stop
exemption.
---
 packages/sdk/src/host/chatactions.ts    | 32 +++++++++++-------
 packages/sdk/test/session-sleep.test.ts | 45 +++++++++++++++++++++++++
 2 files changed, 65 insertions(+), 12 deletions(-)

diff --git a/packages/sdk/src/host/chatactions.ts b/packages/sdk/src/host/chatactions.ts
index e96823744..8da33c677 100644
--- a/packages/sdk/src/host/chatactions.ts
+++ b/packages/sdk/src/host/chatactions.ts
@@ -53,16 +53,18 @@ export function sessionFlag(
 ): boolean {
   const before = ctx.kept.flags(idOf(uri));
   const after = on ? before | bit : before & ~bit;
-  if (after === before) return false;
-  ctx.kept.setFlags(idOf(uri), after);
-  ctx.keepName(idOf(uri));
-  // Every client watching, and the catalogue: a flag one client sets is a flag
-  // the others have to see, which is what having a host for this buys over
-  // each client keeping its own.
-  ctx.dispatch(uri, action, origin);
-  ctx.markSummaryDirty(uri);
-  // Whether its chats may move, which an archived session's may not.
-  if (bit === Status.IsArchived) for (const chat of ctx.sessions.get(uri)?.chats.keys() ?? []) ctx.updateChatMovability(chat);
+  const moved = after !== before;
+  if (moved) {
+    ctx.kept.setFlags(idOf(uri), after);
+    ctx.keepName(idOf(uri));
+    // Every client watching, and the catalogue: a flag one client sets is a flag
+    // the others have to see, which is what having a host for this buys over
+    // each client keeping its own.
+    ctx.dispatch(uri, action, origin);
+    ctx.markSummaryDirty(uri);
+    // Whether its chats may move, which an archived session's may not.
+    if (bit === Status.IsArchived) for (const chat of ctx.sessions.get(uri)?.chats.keys() ?? []) ctx.updateChatMovability(chat);
+  }
   // Archived: asleep, or its tree given back where it is asleep already, and
   // let go by the residency where nothing holds it.
   // https://github.com/microsoft/vscode/blob/a4e689ae13ef7a1fe9b515656b51c9be7c274294/src/vs/platform/agentHost/node/agentService.ts#L1457-L1464
@@ -71,6 +73,12 @@ export function sessionFlag(
     // archived because the seat is being stopped, and a chat that never spoke
     // has nothing to resume by, so that stop alone may sleep it. The flag is
     // read here and passed to this one sleep; no other bit is written.
+    //
+    // Every offer asks, not only the one that moved the bit (@cto 2026-11-21,
+    // #37426): the host sleeps only a session no client watches, so a refusal is
+    // about the watchers of that moment and never a mark on the session. The
+    // bit's own latch above is about not waking clients for a message that moved
+    // nothing, and it stays where it is.
     const stopping = action.stopping === true;
     queueMicrotask(() => {
       void ctx.sleep(uri, stopping).catch(() => undefined);
@@ -79,11 +87,11 @@ export function sessionFlag(
   }
   // Unarchived: the tree back before anything wakes the session into it, and
   // the session is no longer one the host archived.
-  if (bit === Status.IsArchived && !on) {
+  if (bit === Status.IsArchived && !on && moved) {
     ctx.kept.setAutoArchivedAt?.(idOf(uri), undefined);
     void ctx.restoreSessionWorktree(uri);
   }
-  return true;
+  return moved;
 }
 
 /**
diff --git a/packages/sdk/test/session-sleep.test.ts b/packages/sdk/test/session-sleep.test.ts
index 13783841a..da610e8a8 100644
--- a/packages/sdk/test/session-sleep.test.ts
+++ b/packages/sdk/test/session-sleep.test.ts
@@ -22,6 +22,8 @@ import { join } from 'node:path';
 import { afterEach, expect, it } from 'vitest';
 import { chatReducer } from '@microsoft/agent-host-protocol';
 import { createHost } from '../src/host.js';
+import { sessionFlag } from '../src/host/chatactions.js';
+import { Status } from '../src/sessions/catalog.js';
 import { memorySessions } from '../src/sessions/sessions.js';
 import { shellTerminals } from '../src/machines/terminals.js';
 import { echo } from '../../../examples/echo/agent.js';
@@ -800,6 +802,49 @@ it('keeps a never-spoken archived session awake when the archive is not a stop',
   expect(awake()).toBe(1);
 });
 
+/*
+ * #37426, @cto 2026-11-21: an archive offer is a sleep request every time it is
+ * made, not only the once the bit moved. A client watching at the first
+ * evaluation refuses it - the host sleeps only a session nobody watches - and
+ * that refusal is about the watchers of that moment, never a mark on the
+ * session, so the next offer of the same bit asks again and sleeps it. The
+ * bit's own latch stays: a repeated offer still dispatches nothing, because a
+ * client is not woken for a message that moved nothing.
+ */
+it('asks again after a refused archive offer, and only the move dispatches', async () => {
+  const sleeps: string[] = [];
+  const dispatched: string[] = [];
+  const uri = 'ahp-session:/one';
+  let flag = 0;
+  let watched = true;
+  const ctx = {
+    kept: {
+      flags: () => flag,
+      setFlags: (_id: string, value: number): void => { flag = value; },
+    },
+    keepName: (): void => {},
+    dispatch: (channel: string): void => { dispatched.push(channel); },
+    markSummaryDirty: (): void => {},
+    sessions: new Map(),
+    updateChatMovability: (): void => {},
+    sleep: (target: string): Promise<boolean> => { sleeps.push(target); return Promise.resolve(!watched); },
+    reconcile: (): void => {},
+  };
+  const offer = { type: 'session/isArchivedChanged', isArchived: true, stopping: true };
+  const current = async (): Promise<{ moved: boolean; sleeps: number }> => {
+    const moved = sessionFlag(ctx as never, uri, Status.IsArchived, true, offer);
+    await new Promise((r) => { setTimeout(r, 0); });
+    return { moved, sleeps: sleeps.length };
+  };
+  const refused = await current();
+  expect(refused).toEqual({ moved: true, sleeps: 1 });
+  watched = false;
+  const taken = await current();
+  expect(taken).toEqual({ moved: false, sleeps: 2 });
+  expect(dispatched).toEqual([uri]);
+  expect(flag & Status.IsArchived).not.toBe(0);
+});
+
 it('wakes nothing for an archive of a sleeping session\'s default chat, and archives nothing', async () => {
   const knobs: Knobs = { closes: [] };
   const { client, time, open, awake } = await serving(knobs);
-- 
