From 8c1632147ece53b522697ecac2d22d12360624b2 Mon Sep 17 00:00:00 2001
From: "@dev/8" <dev-8@main.hh.invalid>
Date: Sat, 21 Nov 2026 04:15:07 -0800
Subject: [PATCH] fix(sleep): a stop sleeps a never-spoken chat whose session
 is not resumable (#37426)

---
 packages/sdk/src/host/chatactions.ts    |  7 ++-
 packages/sdk/src/host/sleep.ts          | 38 ++++++++++------
 packages/sdk/test/session-sleep.test.ts | 60 +++++++++++++++++++++++--
 3 files changed, 87 insertions(+), 18 deletions(-)

diff --git a/packages/sdk/src/host/chatactions.ts b/packages/sdk/src/host/chatactions.ts
index c8d591734..e96823744 100644
--- a/packages/sdk/src/host/chatactions.ts
+++ b/packages/sdk/src/host/chatactions.ts
@@ -67,8 +67,13 @@ export function sessionFlag(
   // let go by the residency where nothing holds it.
   // https://github.com/microsoft/vscode/blob/a4e689ae13ef7a1fe9b515656b51c9be7c274294/src/vs/platform/agentHost/node/agentService.ts#L1457-L1464
   if (bit === Status.IsArchived && on) {
+    // A stop says so on its own archive offer (#37426): the session is
+    // archived because the seat is being stopped, and a chat that never spoke
+    // has nothing to resume by, so that stop alone may sleep it. The flag is
+    // read here and passed to this one sleep; no other bit is written.
+    const stopping = action.stopping === true;
     queueMicrotask(() => {
-      void ctx.sleep(uri).catch(() => undefined);
+      void ctx.sleep(uri, stopping).catch(() => undefined);
       ctx.reconcile();
     });
   }
diff --git a/packages/sdk/src/host/sleep.ts b/packages/sdk/src/host/sleep.ts
index 37cea0ba9..6f6c9797b 100644
--- a/packages/sdk/src/host/sleep.ts
+++ b/packages/sdk/src/host/sleep.ts
@@ -22,13 +22,19 @@ import type { Turn } from '@microsoft/agent-host-protocol';
  * automations stay, and only the agent behind it is closed.
  */
 export interface Sleep {
-  /** Whether a live session has nothing in hand, and so may sleep. */
-  quiet(uri: string): boolean;
+  /**
+   * Whether a live session has nothing in hand, and so may sleep.
+   *
+   * `stopping` is a seat's stop asking: a chat that never spoke has nothing to
+   * resume by, but a stop is still the end of the seat, so for that stop alone
+   * it counts as quiet (#37426). No flag is written by it.
+   */
+  quiet(uri: string, stopping?: boolean): boolean;
   /**
    * Let a quiet session's agent go. Answers whether it slept. An archived
    * session gives its tree back as well, once it has stopped.
    */
-  sleep(uri: string): Promise<boolean>;
+  sleep(uri: string, stopping?: boolean): Promise<boolean>;
   /**
    * Bring a session that is not live back, resumed in place.
    *
@@ -178,18 +184,22 @@ export function createSleep(ctx: HostContext): Sleep {
     return false;
   };
 
-  const quiet = (uri: string): boolean => {
+  const quiet = (uri: string, stopping = false): boolean => {
     const held = sessions.get(uri);
     const id = idOf(uri);
     if (held === undefined || restarting.has(uri) || closing.has(id) || waking.has(id) || holds.has(id)) return false;
     for (const [chatUri, chat] of held.chats) {
       if (hasActiveTurn(chatUri) || pending(chatUri) || waitingOnPerson(chat)) return false;
-      if (chat.resumable?.() === false || chat.busy?.() === true) return false;
-      // A chat with no conversation yet has nothing to resume by. An archived
-      // session is ended, not resumed: refusing that sleep leaves its agent
-      // running until the window expires and reaps it.
+      // A chat with no conversation yet has nothing to resume by, and its
+      // agent says so. A stop is still the end of the seat: for that stop
+      // alone, a chat that never spoke counts as quiet (#37426).
+      const unheard = chat.allTurns().length === 0;
+      if (chat.resumable?.() === false && !(stopping && unheard)) return false;
+      if (chat.busy?.() === true) return false;
+      // An archived session is ended, not resumed: refusing that sleep leaves
+      // its agent running until the window expires and reaps it.
       if (chat.agentId() === undefined) return false;
-      if (chat.allTurns().length === 0 && !archived(uri)) return false;
+      if (unheard && !archived(uri) && !stopping) return false;
     }
     return !watched(uri);
   };
@@ -197,7 +207,7 @@ export function createSleep(ctx: HostContext): Sleep {
   /** Whether a session is archived, which sleeps it without waiting out the timeout. */
   const archived = (uri: string): boolean => (kept.flags(idOf(uri)) & Status.IsArchived) !== 0;
 
-  const sleep = async (uri: string): Promise<boolean> => {
+  const sleep = async (uri: string, stopping = false): Promise<boolean> => {
     const id = idOf(uri);
     /*
      * An archived session with no agent running here has stopped already, so
@@ -209,7 +219,7 @@ export function createSleep(ctx: HostContext): Sleep {
       void ctx.requestSessionWorktreeRemoval(uri);
       return false;
     }
-    if (!quiet(uri)) return false;
+    if (!quiet(uri, stopping)) return false;
     const held = sessions.get(uri);
     if (held === undefined) return false;
     /*
@@ -222,9 +232,9 @@ export function createSleep(ctx: HostContext): Sleep {
      * new one. Disposing here would put the transcript out of its reach.
      */
     const row = getOverlaySessionSummaries().find((one) => one.resource === uri);
-    const stopping: Promise<void>[] = [];
+    const stoppingChats: Promise<void>[] = [];
     for (const [chatUri, chat] of held.chats) {
-      stopping.push(Promise.resolve(chat.close('stopping')).catch(() => {}));
+      stoppingChats.push(Promise.resolve(chat.close('stopping')).catch(() => {}));
       byChat.drop(chatUri);
       // A wake starts it under this session, which is the relaunch a moved
       // chat owed.
@@ -244,7 +254,7 @@ export function createSleep(ctx: HostContext): Sleep {
     log(`slept ${uri}`);
     activeSessionsChanged();
     markSummaryDirty(uri);
-    const closed = Promise.all(stopping).then(() => undefined);
+    const closed = Promise.all(stoppingChats).then(() => undefined);
     closing.set(id, closed);
     // An archived session gives its tree back once its agents have closed.
     // Queued now, so a wake asked for during the close waits behind it.
diff --git a/packages/sdk/test/session-sleep.test.ts b/packages/sdk/test/session-sleep.test.ts
index 7f31c04f2..13783841a 100644
--- a/packages/sdk/test/session-sleep.test.ts
+++ b/packages/sdk/test/session-sleep.test.ts
@@ -742,10 +742,64 @@ it('sleeps an archived session whose chat never spoke', async () => {
 });
 
 /*
- * VS Code's host refuses an archive of a default chat without restoring the
- * session it is in.
- * https://github.com/microsoft/vscode/blob/a4e689ae13ef7a1fe9b515656b51c9be7c274294/src/vs/platform/agentHost/node/agentService.ts#L12120-L12122
+ * #37426: the stop does not just archive. It first cancels the seat's turn on
+ * one connection, drops that connection, and offers the archive on another,
+ * while it watches the child go. A never-spoken seat must sleep under that
+ * ordering too, or the window expires and the child is reaped with SIGTERM.
  */
+it('sleeps a never-spoken session when a stop cancels a turn and then archives', async () => {
+  const knobs: Knobs = { closes: [] };
+  const { client, open, turns, awake } = await serving(knobs);
+  const one = await open('one', false);
+  expect(await turns(one.chatUri)).toBe(0);
+  // The stop's first act: cancel the seat's turn on a watched chat.
+  await client.handle({
+    method: 'dispatchAction',
+    params: { channel: one.chatUri, clientSeq: 1, action: { type: 'chat/turnCancelled' } },
+  });
+  await settle();
+  await one.leave();
+  // And then the archive that asks the host to sleep it.
+  await client.handle({
+    method: 'dispatchAction',
+    params: { channel: one.channel, clientSeq: 2, action: { type: 'session/isArchivedChanged', isArchived: true } },
+  });
+  await until(() => knobs.closes.length > 0);
+  expect(awake()).toBe(0);
+});
+
+it('sleeps a never-spoken archived session whose chat is not resumable', async () => {
+  const knobs: Knobs = { closes: [], resumable: false };
+  const { client, open, turns, awake } = await serving(knobs);
+  const one = await open('one', false);
+  expect(await turns(one.chatUri)).toBe(0);
+  await one.leave();
+  await client.handle({
+    method: 'dispatchAction',
+    params: { channel: one.channel, clientSeq: 1, action: { type: 'session/isArchivedChanged', isArchived: true, stopping: true } },
+  });
+  await until(() => knobs.closes.length > 0, 2000);
+  expect(awake()).toBe(0);
+});
+
+/*
+ * The stopping flag belongs to that stop alone: an archive that is not a stop
+ * still keeps a chat with nothing to resume by awake, as it did before.
+ */
+it('keeps a never-spoken archived session awake when the archive is not a stop', async () => {
+  const knobs: Knobs = { closes: [], resumable: false };
+  const { client, open, awake } = await serving(knobs);
+  const one = await open('one', false);
+  await one.leave();
+  await client.handle({
+    method: 'dispatchAction',
+    params: { channel: one.channel, clientSeq: 1, action: { type: 'session/isArchivedChanged', isArchived: true } },
+  });
+  await settle(16);
+  expect(knobs.closes.length).toBe(0);
+  expect(awake()).toBe(1);
+});
+
 it('wakes nothing for an archive of a sleeping session\'s default chat, and archives nothing', async () => {
   const knobs: Knobs = { closes: [] };
   const { client, time, open, awake } = await serving(knobs);
-- 
