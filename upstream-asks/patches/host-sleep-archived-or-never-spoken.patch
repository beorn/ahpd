From 9f1716148623809e2982091583429179e659750b Mon Sep 17 00:00:00 2001
From: "@dev/8" <dev-8@main.hh.invalid>
Date: Sat, 21 Nov 2026 02:54:53 -0800
Subject: [PATCH] fix(sleep): sleep an archived session whose chat never spoke

An archived session whose chat has not taken a turn was refused by `quiet()`:
"a chat with no conversation yet has nothing to resume by". That rule is right
for idle eviction and wrong for a stop. The archive action sleeps the session,
`chatactions.ts` swallows the refusal, and the host then reports nothing while
the agent keeps running until its window expires and the window reaps it with
SIGTERM (#37426).

An archived session is ended, not resumed, so it has nothing to keep either.
The zero-turn test now applies only to live sessions; every other refusal is
untouched: an active turn, a pending message, a person being asked, a
non-resumable or busy chat, and an agent that is gone.

The same seat stopped cleanly whenever it had taken one turn, which is why the
symptom looked intermittent.
---
 packages/sdk/src/host/sleep.ts          |  7 +++++--
 packages/sdk/test/session-sleep.test.ts | 27 +++++++++++++++++++++----
 2 files changed, 28 insertions(+), 6 deletions(-)

diff --git a/packages/sdk/src/host/sleep.ts b/packages/sdk/src/host/sleep.ts
index d041b5da7..37cea0ba9 100644
--- a/packages/sdk/src/host/sleep.ts
+++ b/packages/sdk/src/host/sleep.ts
@@ -185,8 +185,11 @@ export function createSleep(ctx: HostContext): Sleep {
     for (const [chatUri, chat] of held.chats) {
       if (hasActiveTurn(chatUri) || pending(chatUri) || waitingOnPerson(chat)) return false;
       if (chat.resumable?.() === false || chat.busy?.() === true) return false;
-      // A chat with no conversation yet has nothing to resume by.
-      if (chat.agentId() === undefined || chat.allTurns().length === 0) return false;
+      // A chat with no conversation yet has nothing to resume by. An archived
+      // session is ended, not resumed: refusing that sleep leaves its agent
+      // running until the window expires and reaps it.
+      if (chat.agentId() === undefined) return false;
+      if (chat.allTurns().length === 0 && !archived(uri)) return false;
     }
     return !watched(uri);
   };
diff --git a/packages/sdk/test/session-sleep.test.ts b/packages/sdk/test/session-sleep.test.ts
index 555ad204c..7f31c04f2 100644
--- a/packages/sdk/test/session-sleep.test.ts
+++ b/packages/sdk/test/session-sleep.test.ts
@@ -172,8 +172,8 @@ async function serving(knobs: Knobs, options: Options = {}) {
     params: { clientId: 'window', protocolVersions: ['0.9.0'], initialSubscriptions: ['ahp-root://'] },
   });
 
-  /** A session with one finished turn, and the channels it is read on. */
-  const open = async (name: string) => {
+  /** A session, with one finished turn unless `spoke` is false, and the channels it is read on. */
+  const open = async (name: string, spoke = true) => {
     const channel = `ahp-session:/${name}`;
     /** The session's own name, which the catalogue lists it by. */
     const resource = `ahp-session:/${name}`;
@@ -191,7 +191,7 @@ async function serving(knobs: Knobs, options: Options = {}) {
       });
       for (let i = 0; i < 200 && await turns(chatUri) === before; i++) await settle(1);
     };
-    await say('hello');
+    if (spoke) await say('hello');
     /** Stop watching the session and its chat, which leaves it free to sleep. */
     const leave = async (): Promise<void> => {
       await client.handle({ method: 'unsubscribe', params: { channel: chatUri } });
@@ -226,7 +226,7 @@ async function serving(knobs: Knobs, options: Options = {}) {
     return rows.items.map((one) => one.resource);
   };
 
-  return { host, client, time, open, active, awake, listed, dir };
+  return { host, client, time, open, turns, active, awake, listed, dir };
 }
 
 it('sleeps a session quiet for longer than the timeout', async () => {
@@ -722,6 +722,25 @@ it('sleeps an archived session at once', async () => {
   expect(awake()).toBe(0);
 });
 
+/*
+ * A session archived before its first turn has nothing to resume by, but it
+ * also has nothing to keep. The archive action sleeps it; refusing there
+ * leaves the agent running until its window expires and the window reaps it.
+ */
+it('sleeps an archived session whose chat never spoke', async () => {
+  const knobs: Knobs = { closes: [] };
+  const { client, open, turns, awake } = await serving(knobs);
+  const one = await open('one', false);
+  expect(await turns(one.chatUri)).toBe(0);
+  await one.leave();
+  await client.handle({
+    method: 'dispatchAction',
+    params: { channel: one.channel, clientSeq: 1, action: { type: 'session/isArchivedChanged', isArchived: true } },
+  });
+  await until(() => knobs.closes.length > 0);
+  expect(awake()).toBe(0);
+});
+
 /*
  * VS Code's host refuses an archive of a default chat without restoring the
  * session it is in.
-- 
