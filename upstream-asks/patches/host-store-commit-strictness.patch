-    flags: (id) => inner.flags(id),
-    config: (id) => inner.config(id),
+    flags: (id) => readable(id).flags(id),
+    config: (id) => readable(id).config(id),
     setFlags: (id, value) => { touched(id, () => { inner.setFlags(id, value); }); },
