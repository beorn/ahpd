@@ -379,7 +382,13 @@ export function fileRecords(dir: string, options: FileRecordsOptions = {}): Reco
         const text = textOfRecord(record);
         const kept = recordFromText(text);
         mkdirSync(folderOf(record.id), { recursive: true, mode: 0o700 });
