Subject: [PATCH] wip(records): carry create-only options and memory conflicts

Refs: @i/30-layers/32350-new-architecture-ahp-ade/34955-hightea-umbrella/35090-r2-host-plugin/35139-session-create-durable-mapping
---
 packages/sdk/src/plugins/plugins.ts      |  2 +-
 packages/sdk/src/resources/records.ts    |  5 ++++-
 packages/sdk/src/types/records.ts        |  9 +++++++--
 packages/sdk/test/plugin-records.test.ts | 20 ++++++++++++++++++++
 packages/server/test/records.test.ts     | 11 +++++++++++
 5 files changed, 43 insertions(+), 4 deletions(-)

diff --git a/packages/sdk/src/plugins/plugins.ts b/packages/sdk/src/plugins/plugins.ts
index 1ac0e18a5..724ec0d73 100644
--- a/packages/sdk/src/plugins/plugins.ts
+++ b/packages/sdk/src/plugins/plugins.ts
@@ -1380,7 +1380,7 @@ export function pluginHost(by: string, given: LoaderContext, options: HostRecord
       get: async (id) => (await opened()).get(id),
       list: async () => (await opened()).list(),
       find: async (match) => (await opened()).find(match),
-      put: async (record) => (await opened()).put(record),
+      put: async (record, options) => (await opened()).put(record, options),
       remove: async (id) => (await opened()).remove(id),
       /*
        * Answers its stop at once, and starts the store's own watch when the
diff --git a/packages/sdk/src/resources/records.ts b/packages/sdk/src/resources/records.ts
index 4533d8917..d34d9037c 100644
--- a/packages/sdk/src/resources/records.ts
+++ b/packages/sdk/src/resources/records.ts
@@ -367,13 +367,16 @@ export const memoryRecords = (): RecordStore => {
         find: async (match) => [...held.values()]
           .filter((record) => Object.entries(match).every(([field, value]) => record[field] === value))
           .map((record) => structuredClone(record)),
-        put: async (record) => {
+        put: async (record, options) => {
           if (typeof record !== 'object' || record === null || Array.isArray(record)) {
             throw new Error(`records ${name}: a record is a JSON object`);
           }
           if (typeof record.id !== 'string' || !isRecordSlug(record.id)) {
             throw new Error(`records ${name}: ${String(record.id)} is not a record id: ${RECORD_SLUG}`);
           }
+          if (options?.createOnly === true && held.has(record.id)) {
+            throw new RpcError(-32010, `records ${name}: ${record.id} already exists; the original record was retained`);
+          }
           const type = held.has(record.id) ? 'updated' : 'added';
           held.set(record.id, structuredClone(record));
           told({ id: record.id, type });
diff --git a/packages/sdk/src/types/records.ts b/packages/sdk/src/types/records.ts
index 60d10ed84..479a693f8 100644
--- a/packages/sdk/src/types/records.ts
+++ b/packages/sdk/src/types/records.ts
@@ -69,8 +69,13 @@ export interface RecordCollection {
   list(): Promise<StoredRecord[]>;
   /** Every record whose top-level fields equal each field of `match`. */
   find(match: Record<string, unknown>): Promise<StoredRecord[]>;
-  /** Keep one record, replacing what its id held. A record whose `id` is not a slug is refused. */
-  put(record: StoredRecord): Promise<void>;
+  /**
+   * Keep one record, replacing what its id held by default. A record whose `id` is not a slug is refused.
+   * createOnly atomically refuses an existing id with conflict code -32010; it never replaces that winner.
+   * A durable store arbitrates on the authoritative complete record, refreshes a conflicting winner before
+   * rejecting, and must keep uncertain publication distinct from a proven conflict.
+   */
+  put(record: StoredRecord, options?: { createOnly?: boolean }): Promise<void>;
   /** Take one record out. `true` when one was there. */
   remove(id: string): Promise<boolean>;
   /** Hear each change to the collection, until the function it answers is called. */
diff --git a/packages/sdk/test/plugin-records.test.ts b/packages/sdk/test/plugin-records.test.ts
index 34544229a..1b550ac03 100644
--- a/packages/sdk/test/plugin-records.test.ts
+++ b/packages/sdk/test/plugin-records.test.ts
@@ -28,6 +28,26 @@ const base = (): HostOptions => ({ path: '/tmp/plugin-records', agents: [] });
 /** A turn of the event loop, for the work a watch starts without a call to await. */
 const settled = (): Promise<void> => new Promise((resolve) => { setTimeout(resolve, 0); });
 
+// The direct store protects the single winner; the plugin path independently catches dropped write options.
+it.each([false, true])('create-only records retain one winner through plugin=%s', async (throughPlugin) => {
+  const saved = memoryRecords();
+  const records = throughPlugin
+    ? pluginHost('fixture', context(), { records: () => saved }).host.records('mappings')
+    : await saved.collection('mappings');
+  const changes: RecordChange[] = [];
+  records.watch(change => { changes.push(change); });
+  await settled();
+  const first = { id: 'logical-key', owner: 'ana', uri: 'original-uri' };
+  const other = { id: 'logical-key', owner: 'bea', uri: 'other-uri' };
+  const results = await Promise.allSettled([records.put(first, { createOnly: true }), records.put(other, { createOnly: true })]);
+  expect(results.map(result => result.status)).toEqual(['fulfilled', 'rejected']);
+  expect(results[1]).toMatchObject({ reason: { code: -32010 } });
+  expect(await records.get(first.id)).toEqual(first);
+  expect(changes).toEqual([{ id: first.id, type: 'added' }]);
+  await records.put(other);
+  expect(await records.get(first.id)).toEqual(other);
+});
+
 // Backend load rejection must reach a persistence consumer, and a repair must permit a later open (#35127).
 // Existing cases cover an absent port, not a present backend whose collection failed to load.
 it('propagates a failed backend open to plugin reads and writes, and retries after repair', async () => {
diff --git a/packages/server/test/records.test.ts b/packages/server/test/records.test.ts
index a46e9f4aa..6f4a713b7 100644
--- a/packages/server/test/records.test.ts
+++ b/packages/server/test/records.test.ts
@@ -38,6 +38,17 @@ const bot = {
   instructions: 'Answer briefly.\n\nUse the tools: a, b.\n',
 };
 
+// Two stores opened before either writes must arbitrate on the complete disk record, not their cached absence.
+it('create-only file records refresh the actual winner after a stale-cache conflict', async () => {
+  const first = await store().collection('mappings', { format: 'json' });
+  const second = await store().collection('mappings', { format: 'json' });
+  const winner = { id: 'logical-key', owner: 'ana', uri: 'original-uri' };
+  await first.put(winner, { createOnly: true });
+  await expect(second.put({ id: winner.id, owner: 'bea', uri: 'other-uri' }, { createOnly: true })).rejects.toMatchObject({ code: -32010 });
+  expect(JSON.parse(readFileSync(join(dir, 'mappings', `${winner.id}.json`), 'utf8'))).toEqual(winner);
+  expect(await second.get(winner.id)).toEqual(winner);
+});
+
 /** Every change a collection tells, from now on. */
 const heard = (collection: RecordCollection): RecordChange[] => {
   const changes: RecordChange[] = [];
