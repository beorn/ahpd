@@ -76,6 +76,37 @@ const locations = new WeakMap<AcpOptions, { machines?: SessionMachine[]; host?:
  */
 const failedOnHost = new WeakSet<AcpOptions>();
 
+/**
+ * The records that keep sessions whose host server died before it answered
+ * the handshake, with what it was spawned from and when to try again (#37753).
+ *
+ * A record that keeps sessions is not put in `failedOnHost`: its listing is
+ * the host's, and the host asks again at every pass. A server that dies before
+ * the handshake - its env file gone, its command exiting at once - mostly dies
+ * the same way at each, so without this it is spawned, and its failure logged,
+ * at every pass. A read before `retryAt` is answered with the same death and
+ * nothing is spawned; the wait doubles from a minute up to fifteen with each
+ * death, so a failure that heals - a command back after a switch, a token file
+ * minted again at the same path - heals by itself. A changed input or a
+ * listing that answers clears it. The inputs are compared rather than the
+ * record itself, because an edit updates the record `open` was handed in place
+ * (`sdk/src/agents/channel.ts`). A server that answered the handshake and then
+ * failed its listing is asked again at the next read, as before.
+ */
+const diedEarly = new WeakMap<AcpOptions, { inputs: string; death: Error; failures: number; retryAt: number }>();
+
+/** The first wait after a host server died before the handshake, doubled at each death after it. */
+const SPAWN_RETRY_FIRST_MS = 60_000;
+/** The longest wait between spawns of a host server that keeps dying before the handshake. */
+const SPAWN_RETRY_MOST_MS = 15 * 60_000;
+
+/** The listing connections whose server answered the handshake, so a later failure is not taken for a death before it. */
+const handshaken = new WeakSet<AcpConnection>();
+
+/** What a listing's server is spawned from, as one string to compare; never logged, since `env` may hold a secret. */
+const spawnInputsOf = (options: AcpOptions): string =>
+  JSON.stringify([options.command, options.args ?? [], options.cwd ?? null, Object.entries(options.env ?? {}).sort()]);
+
