+    const inputs = spawnInputsOf(options);
+    const early = diedEarly.get(options);
+    if (early !== undefined && early.inputs !== inputs) diedEarly.delete(options);
+    else if (early !== undefined && Date.now() < early.retryAt) throw early.death;
