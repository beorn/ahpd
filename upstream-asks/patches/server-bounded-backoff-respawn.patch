+        diedEarly.set(options, { inputs, death, failures, retryAt: Date.now() + waitMs });
+        options.log?.(`${provider}: server ended before initialize (${death.message}); next spawn attempt in ${waitMs / 60_000} min`, 'error');
+        throw error;
+      }
       options.log?.(`${provider}: session/list failed: ${error instanceof Error ? error.message : String(error)}`, 'error');
