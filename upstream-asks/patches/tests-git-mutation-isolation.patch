Subject: [PATCH] test: detect checkout Git mutations during ahpd tests

Refs: @i/30-layers/32350-new-architecture-ahp-ade/34955-hightea-umbrella/35090-r2-host-plugin/37182-ahpd-test-isolation
---
 packages/sdk/test/test-git.test.ts | 34 +++++++++++++++++++++++++++++-
 tools/test-tmpdir.ts               | 27 ++++++++++++++++++++++--
 2 files changed, 58 insertions(+), 3 deletions(-)

diff --git a/packages/sdk/test/test-git.test.ts b/packages/sdk/test/test-git.test.ts
index 7b73b0232..df20ce655 100644
--- a/packages/sdk/test/test-git.test.ts
+++ b/packages/sdk/test/test-git.test.ts
@@ -1,8 +1,10 @@
-import { readdirSync, readFileSync } from 'node:fs';
+import { mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
 import { join } from 'node:path';
 import { fileURLToPath } from 'node:url';
 import { afterEach, expect, it, vi } from 'vitest';
 import { gitSync } from '../../../tools/git.ts';
+import setup from '../../../tools/test-tmpdir.ts';
 
 /*
  * A test's own `git`: answered as a string, timed like the host's calls, and
@@ -23,6 +25,7 @@ it('answers a call as a string', () => {
 
 it('says a call over AHPD_GIT_SLOW_MS on stderr, with its arguments', () => {
   process.env['AHPD_GIT_SLOW_MS'] = '1';
+  vi.spyOn(Date, 'now').mockReturnValueOnce(0).mockReturnValueOnce(2);
   const said: string[] = [];
   vi.spyOn(process.stderr, 'write').mockImplementation((line) => { said.push(String(line)); return true; });
   gitSync(['--version']);
@@ -58,3 +61,32 @@ it('finds no test that runs git without gitSync', () => {
     .filter((file) => DIRECT.test(readFileSync(join(ROOT, file), 'utf8')));
   expect(direct).toEqual([]);
 });
+
+/*
+ * A run must fail if a suite writes the checkout's Git bookkeeping. The
+ * temporary repository stands in for the checkout; no real checkout is
+ * mutated, even when the integrity check is missing.
+ */
+it.each(['refs', 'HEAD', 'index', 'unchanged'] as const)('checks checkout %s after a test run', (part) => {
+  const dir = mkdtempSync(join(tmpdir(), 'ahpd-checkout-integrity-'));
+  const env = { ...process.env };
+  const git = (...args: string[]): string => gitSync(['-C', dir, ...args]);
+  try {
+    git('init', '-q', '-b', 'main');
+    git('-c', 'user.name=Test', '-c', 'user.email=test@example.com', 'commit', '-q', '--allow-empty', '-m', 'fixture');
+    const finish = setup({ config: { root: dir } });
+    if (part === 'refs') git('update-ref', 'refs/agents/witness/checkpoints/turn/0', 'HEAD');
+    if (part === 'HEAD') git('symbolic-ref', 'HEAD', 'refs/heads/another');
+    if (part === 'index') {
+      writeFileSync(join(dir, 'staged.txt'), 'fixture\n');
+      git('add', 'staged.txt');
+    }
+    if (part === 'unchanged') expect(finish).not.toThrow();
+    else expect(finish).toThrow(/a test changed checkout Git/);
+  }
+  finally {
+    for (const key of Object.keys(process.env)) if (!(key in env)) delete process.env[key];
+    Object.assign(process.env, env);
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
diff --git a/tools/test-tmpdir.ts b/tools/test-tmpdir.ts
index be49921ab..1cb632488 100644
--- a/tools/test-tmpdir.ts
+++ b/tools/test-tmpdir.ts
@@ -1,7 +1,8 @@
-import { existsSync, mkdtempSync, realpathSync, rmSync } from 'node:fs';
+import { existsSync, mkdtempSync, readFileSync, realpathSync, rmSync } from 'node:fs';
 import { tmpdir } from 'node:os';
 import { join } from 'node:path';
 import { fileURLToPath } from 'node:url';
+import { gitSync } from './git.ts';
 
 /*
  * One temporary folder per test run, removed when the run ends.
@@ -12,7 +13,20 @@ import { fileURLToPath } from 'node:url';
  * run whatever a test forgot. Windows reads `TEMP` or `TMP` rather than
  * `TMPDIR`, so all three name the run's folder.
  */
-export default function setup(): () => void {
+export default function setup(project: { config: { root: string } }): () => void {
+  const checkout = project.config.root;
+  // An archive has no checkout metadata. A worktree's .git can be a file.
+  const gitFile = (name: string): string => gitSync([
+    '-C', checkout, 'rev-parse', '--path-format=absolute', '--git-path', name,
+  ]).trim();
+  const head = existsSync(join(checkout, '.git')) ? gitFile('HEAD') : undefined;
+  const index = head === undefined ? undefined : gitFile('index');
+  const snapshot = () => ({
+    refs: gitSync(['-C', checkout, 'for-each-ref', '--format=%(refname) %(objectname)']),
+    HEAD: readFileSync(head as string, 'utf8'),
+    index: index !== undefined && existsSync(index) ? readFileSync(index).toString('hex') : null,
+  });
+  const before = head === undefined ? undefined : snapshot();
   /*
    * By its long name. A Windows runner's temp folder is an 8.3 short one
    * (`C:\Users\RUNNER~1\...`), and git answers every path by its long name, so
@@ -60,6 +74,8 @@ export default function setup(): () => void {
    */
   process.env.AHPD_TEST_WORK = join(run, 'work');
   return () => {
+    // Observe before cleanup, so cleanup cannot hide a checkout mutation.
+    const after = before === undefined ? undefined : snapshot();
     /*
      * The run's folder goes, and a folder Windows will not let go of is said,
      * not thrown. Every test has passed or failed by now, and a file a process
@@ -92,5 +108,12 @@ export default function setup(): () => void {
         `a test wrote ${stray}: a state directory must be a temporary one, not this repository`,
       );
     }
+    if (before !== undefined && after !== undefined) {
+      const changed = (Object.keys(before) as (keyof typeof before)[])
+        .filter((key) => before[key] !== after[key]);
+      if (changed.length !== 0) throw new Error(
+        `a test changed checkout Git ${changed.join(', ')} in ${checkout}: use a temporary repository`,
+      );
+    }
   };
 }
